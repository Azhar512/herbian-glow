{
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/dist/client/assets/$1"
    },
    {
      "source": "/images/(.*)",
      "destination": "/dist/client/images/$1"
    },
    {
      "source": "/favicon.svg",
      "destination": "/dist/client/favicon.svg"
    },
    {
      "source": "/logo.webp",
      "destination": "/dist/client/logo.webp"
    },
    {
      "source": "/robots.txt",
      "destination": "/dist/client/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
